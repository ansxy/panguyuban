{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panguyuban",
  "version": "0.1.0",
  "identifier": "com.ansar.panguyuban",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Panguyuban: Plane Ticket and GitHub Pull Request Console",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  }
}
