{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panguyuban",
  "version": "0.1.0",
  "identifier": "com.ansar.panguyuban",
  "build": {
    "beforeDevCommand": "sh ../../scripts/build-pangu.sh debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh ../../scripts/build-pangu.sh release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Panguyuban",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "externalBin": ["binaries/pangu-cli"]
  }
}
